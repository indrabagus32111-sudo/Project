                local function buildOptionsList(newOptions, resetSelected)
                    options = newOptions or {}
                    if resetSelected then table.clear(selected) end
                    for _, btn in pairs(optionButtons) do if btn and btn.Parent then btn:Destroy() end end
                    optionButtons = {}

                    for _, opt in ipairs(options) do
                        local OptBtn = Create("TextButton", {
                            Parent = ListScrolling,
                            Text = "  " .. tostring(opt),
                            Font = Enum.Font.Gotham,
                            TextSize = 10,
                            TextColor3 = SubTextColor,
                            BackgroundColor3 = BackgroundColor,
                            BackgroundTransparency = 0.5,
                            Size = UDim2.new(1, 0, 0, 22),
