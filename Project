                        BackgroundTransparency = 1,
                        Size = UDim2.new(1, 0, 1, 0),
                        AutoButtonColor = false,
                        ZIndex = 11
                    })

                    local function setSliderValue(newVal, ignoreCallback)
                        value = math.clamp(math.floor(tonumber(newVal) or min), min, max)
                        ValueBox.Text = tostring(value)

                        local newPercentage = (max == min) and 0 or ((value - min) / (max - min))

                        SliderFill.Size = UDim2.new(newPercentage, 0, 1, 0)
                        SliderKnob.Position = UDim2.new(newPercentage, -6, 0.5, -6)

                        if callback and not ignoreCallback then
                            callback(value)
                        end
                    end

                    local dragging = false

                    local function updateFromInput(input)
                        local sizeX = math.clamp(
                            (input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X,
                            0,
                            1
                        )

                        setSliderValue(min + ((max - min) * sizeX))
                    end

                    SliderBtn.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            dragging = true
                            updateFromInput(input)
                        end
                    end)

                    UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            dragging = false
                        end
                    end)

                    UserInputService.InputChanged:Connect(function(input)
                        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                            updateFromInput(input)
                        end
                    end)

                    ValueBox.FocusLost:Connect(function()
                        local num = tonumber(ValueBox.Text)

                        if num then
                            setSliderValue(num)
                        else
                            ValueBox.Text = tostring(value)
                        end
                    end)

                    Window.ConfigElements[name] = {
                        Set = function(val)
                            setSliderValue(val)
                        end,
                        Get = function()
                            return value
                        end
                    }
                end

