        contentWrapper.Size = UDim2.new(1, 0, 0, contentH)
    end
    contentListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCategoryHeight)
    task.defer(updateCategoryHeight)
    header.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        contentWrapper.Visible = isOpen
        arrow.Rotation = isOpen and 180 or 0
        updateCategoryHeight()
    end)
    return contentContainer
end

-- [FIX] Tombol On/Off (Toggle) berubah menjadi warna Hitam/Kuning padat (tidak hitam-putih)
function Library:CreateToggle(parent, label, configPath, callback, disableSave, defaultValue)
    local frame = new("Frame", {Parent = parent, Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, ZIndex = 7})
    new("TextLabel", {
        Parent = frame,
        Text = label,
        Size = UDim2.new(1, -45, 1, 0),
        BackgroundTransparency = 1,
        TextColor3 = colors.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        Font = Enum.Font.GothamBold,
        TextSize = fontSize.small,
        ZIndex = 8
    })
    local toggleBg = new("Frame", {
        Parent = frame,
        Size = UDim2.new(0, 40, 0, 22),
        Position = UDim2.new(1, -40, 0.5, -11),
        BackgroundColor3 = colors.bg3,
        BorderSizePixel = 0,
        ZIndex = 8
    })
    new("UICorner", {Parent = toggleBg, CornerRadius = UDim.new(1, 0)})
    local toggleCircle = new("Frame", {
        Parent = toggleBg,
        Size = UDim2.new(0, 18, 0, 18),
        Position = UDim2.new(0, 2, 0.5, -9),
        BackgroundColor3 = colors.textDim,
        BorderSizePixel = 0,
        ZIndex = 9
    })
    new("UICorner", {Parent = toggleCircle, CornerRadius = UDim.new(1, 0)})
    local btn = new("TextButton", {Parent = toggleBg, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", ZIndex = 10})
    
    local on = defaultValue or false
    if configPath and not disableSave then
        on = Library.ConfigSystem.Get(configPath, on)
    end
    
    local function updateVisual(instant)
        -- Ketika dinyalakan (on = true), warna latar belakang jadi kuning primer dan lingkaran jadi hitam (bg1)
        local targetColor = on and colors.primary or colors.bg3
        local targetPos = on and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
        local targetCircleColor = on and colors.bg1 or colors.textDim
        
        if instant then
            toggleBg.BackgroundColor3 = targetColor
            toggleCircle.Position = targetPos
            toggleCircle.BackgroundColor3 = targetCircleColor
        else
            TweenService:Create(toggleBg, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = targetColor}):Play()
            TweenService:Create(toggleCircle, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = targetPos, BackgroundColor3 = targetCircleColor}):Play()
        end
    end
    
    updateVisual(true)
    
    self:AddConnection("toggle_" .. label .. tostring(btn), btn.MouseButton1Click:Connect(function()
        on = not on
        updateVisual(false)
        if configPath and not disableSave then
            Library.ConfigSystem.Set(configPath, on)
            MarkDirty()
        end
        self.flags[configPath or label] = on
        if callback then callback(on) end
    end))
    
    self.flags[configPath or label] = on
    return {
        frame = frame,
        set = function(val)
            on = val
            updateVisual(false)
            self.flags[configPath or label] = on
        end,
        get = function() return on end
    }
end

