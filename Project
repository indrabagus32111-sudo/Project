                })

                local SliderBar = Create("Frame", {
                    Parent = SliderFrame,
                    BackgroundColor3 = Color3.fromRGB(50, 50, 50),
                    Size = UDim2.new(1, -12, 0, 6),
                    Position = UDim2.new(0, 6, 0, 24),
                    ZIndex = 10
                })
                Create("UICorner", {Parent = SliderBar, CornerRadius = UDim.new(1, 0)})

                local SliderFill = Create("Frame", {
                    Parent = SliderBar,
                    BackgroundColor3 = AccentColor,
                    Size = UDim2.new(percentage, 0, 1, 0),
                    ZIndex = 11
                })
                Create("UICorner", {Parent = SliderFill, CornerRadius = UDim.new(1, 0)})

                local SliderKnob = Create("Frame", {
                    Parent = SliderBar,
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                    Size = UDim2.new(0, 12, 0, 12),
                    Position = UDim2.new(percentage, -6, 0.5, -6),
                    ZIndex = 12
                })
                Create("UICorner", {Parent = SliderKnob, CornerRadius = UDim.new(1, 0)})

                local SliderBtn = Create("TextButton", {
                    Parent = SliderBar,
                    Text = "",
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 1, 0),
                    AutoButtonColor = false,
                    ZIndex = 13
                })

                local function setSliderValue(newVal, ignoreCallback)
                    value = math.clamp(math.floor(tonumber(newVal) or min), min, max)
                    ValueBox.Text = tostring(value)
                    local newPercentage = (max == min) and 0 or ((value - min) / (max - min))
                    SliderFill.Size = UDim2.new(newPercentage, 0, 1, 0)
                    SliderKnob.Position = UDim2.new(newPercentage, -6, 0.5, -6)
                    if configPath and not noSave then
                        Library.ConfigSystem.Set(configPath, value)
                        MarkDirty()
                    end
                    if callback and not ignoreCallback then callback(value) end
                end

                local dragging = false
                local function updateFromInput(input)
                    local sizeX = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
                    setSliderValue(min + ((max - min) * sizeX))
                end

                SliderBtn.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        updateFromInput(input)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        updateFromInput(input)
                    end
                end)
                ValueBox.FocusLost:Connect(function()
                    local num = tonumber(ValueBox.Text)
                    if num then setSliderValue(num) else ValueBox.Text = tostring(value) end
                end)

                if configPath and not noSave then
                    RegisterCallback(configPath, callback, "slider", default, function(val)
                        setSliderValue(val, true)
                    end)
                end
                registerFeature(name, SliderFrame)

                return {
                    SetValue = function(self, val) setSliderValue(val) end,
                    GetValue = function(self) return value end
                }
            end

