                            TextXAlignment = Enum.TextXAlignment.Left,
                            ZIndex = 52
                        })
                        Create("UICorner", {Parent = OptBtn, CornerRadius = UDim.new(0, 3)})
                        local CheckMark = Create("TextLabel", {
                            Parent = OptBtn,
                            Name = "CheckMark",
                            Text = "",
                            Font = Enum.Font.GothamBold,
                            TextSize = 10,
                            TextColor3 = Color3.fromRGB(255, 255, 255),
                            BackgroundTransparency = 1,
                            Size = UDim2.new(0, 20, 1, 0),
                            Position = UDim2.new(1, -22, 0, 0),
                            TextXAlignment = Enum.TextXAlignment.Center,
                            ZIndex = 53
                        })
                        optionButtons[opt] = OptBtn

                        OptBtn.MouseButton1Click:Connect(function()
                            if multi then
                                selected[opt] = not selected[opt]
                            else
                                table.clear(selected)
                                selected[opt] = true
                            end
                            updatePreview()
                            if configPath and not noSave then
                                local res = multi and (function()
                                    local t = {}
                                    for _, o in ipairs(options) do if selected[o] then table.insert(t, o) end end
                                    return t
                                end)() or opt
                                Library.ConfigSystem.Set(configPath, res)
                                MarkDirty()
                            end
                            if callback then
                                if multi then
                                    local result = {}
                                    for _, o in ipairs(options) do if selected[o] then table.insert(result, o) end end
                                    callback(result)
                                else
                                    callback(opt)
                                end
                            end
                        end)
                    end
                    updatePreview()
                end

                updatePreview = function()
                    local list = {}
                    for _, opt in ipairs(options) do
                        if selected[opt] then table.insert(list, tostring(opt)) end
                    end
                    if #list > 2 then
                        PreviewText.Text = string.format("%s, %s, ...", tostring(list[1]), tostring(list[2]))
                    else
                        PreviewText.Text = table.concat(list, ", ")
                    end
                    if PreviewText.Text == "" then PreviewText.Text = "None" end

                    for opt, btn in pairs(optionButtons) do
                        local checkMark = btn:FindFirstChild("CheckMark")
                        if selected[opt] then
                            Tween(btn, {BackgroundColor3 = Color3.fromRGB(60, 60, 60), BackgroundTransparency = 0.2}, 0.2)
                            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                            if checkMark then checkMark.Text = "✓" end
                        else
                            Tween(btn, {BackgroundColor3 = BackgroundColor, BackgroundTransparency = 0.5}, 0.2)
                            btn.TextColor3 = SubTextColor
                            if checkMark then checkMark.Text = "" end
                        end
                    end
                end

                ListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                    ListScrolling.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y + 6)
                end)

                DropSearchInput:GetPropertyChangedSignal("Text"):Connect(function()
                    local query = DropSearchInput.Text:lower()
                    for _, opt in ipairs(options) do
                        local btn = optionButtons[opt]
                        if btn then
                            btn.Visible = (query == "" or string.find(tostring(opt):lower(), query, 1, true) ~= nil)
                        end
                    end
                end)

                buildOptionsList(options, false)

                DropBtn.MouseButton1Click:Connect(function()
                    opened = not opened
                    if opened then
                        ListFrame.Visible = true
                        local targetHeight = 130
                        Tween(DropFrame, {Size = UDim2.new(1, 0, 0, 28 + targetHeight)}, 0.2)
                        Tween(ListFrame, {Size = UDim2.new(1, 0, 0, targetHeight)}, 0.2)
                    else
                        Tween(DropFrame, {Size = UDim2.new(1, 0, 0, 28)}, 0.2)
                        Tween(ListFrame, {Size = UDim2.new(1, 0, 0, 0)}, 0.2)
                        task.wait(0.2)
                        ListFrame.Visible = false
                    end
                end)

                registerFeature(title, DropFrame)
                return {
                    SetOptions = function(self, newOpts) buildOptionsList(newOpts, true) end,
                    GetOptions = function(self) return options end
                }
            end

