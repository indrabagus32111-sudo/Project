        if self._currentPage ~= name then
            textLbl.TextColor3 = colors.text
            iconLabel.ImageColor3 = colors.text
        end
    end))
    self:AddConnection("navHoverOut_" .. name, btn.MouseLeave:Connect(function()
        if self._currentPage ~= name then
            textLbl.TextColor3 = colors.textDim
            iconLabel.ImageColor3 = colors.textDim
        end
    end))

    self._navButtons[name] = {btn = btn, page = page, title = title, textLabel = textLbl, iconLabel = iconLabel}
    self:AddConnection("navBtn_" .. name, btn.MouseButton1Click:Connect(function()
        self:_switchPage(name)
    end))
    return contentContainer
end

function Library:SetFirstPage(name)
    self:_switchPage(name)
end

function Library:_switchPage(pageName)
    if self._currentPage == pageName then return end
    for _, pageData in pairs(self.pages) do
        pageData.frame.Visible = false
    end
    for name, data in pairs(self._navButtons) do
        local isActive = (name == pageName)
        data.textLabel.TextColor3 = isActive and colors.primary or colors.textDim
        data.iconLabel.ImageColor3 = isActive and colors.primary or colors.textDim
    end
    if self.pages[pageName] then
        self.pages[pageName].frame.Visible = true
        if self._pageTitle then
            self._pageTitle.Text = self.pages[pageName].title or pageName
        end
    end
    self._currentPage = pageName
end

