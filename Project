        Create("UIListLayout", {Parent = PageNav, FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 12), VerticalAlignment = Enum.VerticalAlignment.Center})
        local PageContainer = Create("Frame", {Parent = TabContent, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -32), Position = UDim2.new(0, 0, 0, 32)})

        local TabConfig = {Button = TabBtn, Content = TabContent, Indicator = Indicator, Txt = Txt, Pages = {}, CurrentPage = nil, LastSection = nil, DefaultPage = nil}
        table.insert(Window.Tabs, TabConfig)

        local function ensureDefaultPageAndSection()
            if #TabConfig.Pages == 0 then TabConfig.DefaultPage = TabConfig:CreatePage("Overview") end
            if not TabConfig.LastSection and TabConfig.DefaultPage then TabConfig.LastSection = TabConfig.DefaultPage:CreateSection("General") end
        end

        function TabConfig:AddSection(secName)
            if #TabConfig.Pages == 0 then TabConfig.DefaultPage = TabConfig:CreatePage("Overview") end
            TabConfig.LastSection = TabConfig.DefaultPage:CreateSection(secName)
            return TabConfig.LastSection
        end

        function TabConfig:AddParagraph(title, desc)
            ensureDefaultPageAndSection()
            return TabConfig.LastSection:AddParagraph(title, desc)
        end

        function TabConfig:AddButton(name, cb)
            ensureDefaultPageAndSection()
            return TabConfig.LastSection:AddButton(name, cb)
        end

        function TabConfig:AddToggle(name, def, cb)
            ensureDefaultPageAndSection()
            return TabConfig.LastSection:AddToggle(name, def, cb)
        end

        function TabConfig:AddSlider(name, min, max, def, cb)
            ensureDefaultPageAndSection()
            return TabConfig.LastSection:AddSlider(name, min, max, def, cb)
        end

        function TabConfig:AddDropdown(name, opts, def, cb, multi)
            ensureDefaultPageAndSection()
            return TabConfig.LastSection:AddDropdown(name, opts, def, cb, multi)
        end

        TabBtn.MouseButton1Click:Connect(function()
            if Window.CurrentTab == TabConfig then return end
            if Window.CurrentTab then
                Tween(Window.CurrentTab.Button, {BackgroundTransparency = 1}, 0.2)
                Tween(Window.CurrentTab.Indicator, {Size = UDim2.new(0, 3, 0, 0)}, 0.2)
                Tween(Window.CurrentTab.Txt, {TextColor3 = SubTextColor}, 0.2)
                Window.CurrentTab.Content.Visible = false
            end
            Window.CurrentTab = TabConfig
            TabConfig.Content.Visible = true
            Tween(TabBtn, {BackgroundTransparency = 0}, 0.2)
            Tween(Indicator, {Size = UDim2.new(0, 3, 0, 16)}, 0.3)
            Tween(Txt, {TextColor3 = TextColor}, 0.2)

            if #TabConfig.Pages > 0 and not TabConfig.CurrentPage then
                TabConfig.CurrentPage = TabConfig.Pages[1]
                TabConfig.CurrentPage.Scroll.Visible = true
            end
        end)

        function TabConfig:CreatePage(pageName)
            local PageBtn = Create("TextButton", {Parent = PageNav, Text = pageName, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = SubTextColor, BackgroundTransparency = 1, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X})
            local PageHighlight = Create("Frame", {Parent = PageBtn, BackgroundColor3 = AccentColor, Size = UDim2.new(0, 0, 0, 2), Position = UDim2.new(0.5, 0, 1, -4), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1})
            local PageScroll = Create("ScrollingFrame", {Parent = PageContainer, BackgroundTransparency = 1, Size = UDim2.new(1, -8, 1, -8), Position = UDim2.new(0, 4, 0, 4), ScrollBarThickness = 2, ScrollBarImageColor3 = Color3.fromRGB(60, 40, 45), Visible = false, BorderSizePixel = 0})

            local MainColumn = Create("Frame", {Parent = PageScroll, BackgroundTransparency = 1, Size = UDim2.new(1, -12, 1, 0)})
            local M_Layout = Create("UIListLayout", {Parent = MainColumn, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10)})
            M_Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() 
                PageScroll.CanvasSize = UDim2.new(0, 0, 0, M_Layout.AbsoluteContentSize.Y + 20) 
            end)

            local PageObj = {Scroll = PageScroll, Btn = PageBtn, Highlight = PageHighlight, MainColumn = MainColumn}
            table.insert(TabConfig.Pages, PageObj)

            PageBtn.MouseButton1Click:Connect(function()
                if TabConfig.CurrentPage == PageObj then return end
                if TabConfig.CurrentPage then
                    Tween(TabConfig.CurrentPage.Btn, {TextColor3 = SubTextColor}, 0.2)
                    Tween(TabConfig.CurrentPage.Highlight, {Size = UDim2.new(0, 0, 0, 2), BackgroundTransparency = 1}, 0.2)
                    TabConfig.CurrentPage.Scroll.Visible = false
                end
                TabConfig.CurrentPage = PageObj
                PageObj.Scroll.Visible = true
                Tween(PageBtn, {TextColor3 = TextColor}, 0.2)
                Tween(PageHighlight, {Size = UDim2.new(1, 0, 0, 2), BackgroundTransparency = 0}, 0.3)
            end)

            if #TabConfig.Pages == 1 then
                TabConfig.CurrentPage = PageObj
                PageObj.Scroll.Visible = true
                PageBtn.TextColor3 = TextColor
                PageHighlight.Size = UDim2.new(1, 0, 0, 2)
                PageHighlight.BackgroundTransparency = 0
            end

            function PageObj:CreateSection(secName)
                local SectionContainer = Create("Frame", {Parent = MainColumn, BackgroundColor3 = CardColor, Size = UDim2.new(1, 0, 0, 30), AutomaticSize = Enum.AutomaticSize.Y, ClipsDescendants = false})
                Create("UICorner", {Parent = SectionContainer, CornerRadius = UDim.new(0, 6)})
                AddCornerBorders(SectionContainer, AccentColor)
                Create("UIStroke", {Parent = SectionContainer, Color = Color3.fromRGB(60, 38, 44), Thickness = 1.2})
                
                table.insert(Window.AllCards, {Card = SectionContainer, OrigParent = MainColumn, Tab = TabConfig, Page = PageObj, SearchIndex = nil})
                
                Create("TextLabel", {Parent = SectionContainer, Text = secName, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = TextColor, BackgroundTransparency = 1, Size = UDim2.new(1, -20, 0, 30), Position = UDim2.new(0, 14, 0, 0), TextXAlignment = Enum.TextXAlignment.Left})
                local ItemContainer = Create("Frame", {Parent = SectionContainer, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 0, 30), AutomaticSize = Enum.AutomaticSize.Y})
                Create("UIPadding", {Parent = ItemContainer, PaddingBottom = UDim.new(0, 12), PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14)})
                Create("UIListLayout", {Parent = ItemContainer, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8)})

                local Elements = {}

                function Elements:AddParagraph(title, desc)
                    local ParaFrame = Create("Frame", {Parent = ItemContainer, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y})
                    Create("TextLabel", {Parent = ParaFrame, Text = title, Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = TextColor, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 0, 0), TextXAlignment = Enum.TextXAlignment.Left})
                    Create("TextLabel", {Parent = ParaFrame, Text = tostring(desc), Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = SubTextColor, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, AutomaticSize = Enum.AutomaticSize.Y})
                    Create("UIPadding", {Parent = ParaFrame, PaddingBottom = UDim.new(0, 6)})
                end

                function Elements:AddButton(name, callback, infoData)
                    local BtnFrame = Create("Frame", {Parent = ItemContainer, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34)})
                    local Btn = Create("TextButton", {Parent = BtnFrame, Text = name, Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = TextColor, BackgroundColor3 = CardColor, Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(0, 0, 0, 0), AutoButtonColor = false})
                    Create("UICorner", {Parent = Btn, CornerRadius = UDim.new(0, 6)})
                    AddCornerBorders(Btn, AccentColor)
                    Create("UIStroke", {Parent = Btn, Color = Color3.fromRGB(70, 40, 46), Thickness = 1.2})
                    AddBounce(Btn)
                    Btn.MouseEnter:Connect(function() Tween(Btn, {BackgroundColor3 = HoverColor}, 0.2) end)
                    Btn.MouseLeave:Connect(function() Tween(Btn, {BackgroundColor3 = CardColor}, 0.2) end)
                    Btn.MouseButton1Click:Connect(function() if callback then callback() end end)
                end

                function Elements:AddToggle(name, default, callback)
                    local state = default or false
                    local TogFrame = Create("Frame", {Parent = ItemContainer, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30)})
                    Create("TextLabel", {Parent = TogFrame, Text = name, Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = SubTextColor, BackgroundTransparency = 1, Size = UDim2.new(1, -55, 1, 0), Position = UDim2.new(0, 0, 0, 0), TextXAlignment = Enum.TextXAlignment.Left})
                    local Lever = Create("TextButton", {Parent = TogFrame, Text = "", BackgroundColor3 = state and AccentColor or Color3.fromRGB(50, 35, 40), Size = UDim2.new(0, 40, 0, 20), Position = UDim2.new(1, -44, 0.5, -10), AutoButtonColor = false})
                    Create("UICorner", {Parent = Lever, CornerRadius = UDim.new(1, 0)})
                    Create("UIStroke", {Parent = Lever, Color = Color3.fromRGB(80, 50, 55), Thickness = 1})
                    AddBounce(Lever)
                    local Knob = Create("Frame", {Parent = Lever, BackgroundColor3 = Color3.fromRGB(255, 255, 255), Size = UDim2.new(0, 16, 0, 16), Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)})
                    Create("UICorner", {Parent = Knob, CornerRadius = UDim.new(1, 0)})

                    local function internalSet(val)
                        state = val
                        Tween(Lever, {BackgroundColor3 = state and AccentColor or Color3.fromRGB(50, 35, 40)}, 0.3)
                        Tween(Knob, {Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)}, 0.3)
                        if callback then callback(state) end
                    end

                    Lever.MouseButton1Click:Connect(function() internalSet(not state) end)
                    Window.ConfigElements[name] = { Set = internalSet, Get = function() return state end }
                end

                function Elements:AddSlider(name, min, max, default, callback)
                    min = min or 0
                    max = max or 100
                    default = default or min
                    local value = math.clamp(default, min, max)

                    local SliderFrame = Create("Frame", {Parent = ItemContainer, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 46)})
                    Create("TextLabel", {Parent = SliderFrame, Text = name, Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = SubTextColor, BackgroundTransparency = 1, Size = UDim2.new(1, -70, 0, 18), Position = UDim2.new(0, 0, 0, 0), TextXAlignment = Enum.TextXAlignment.Left})
                    
                    local ValueBox = Create("TextBox", {Parent = SliderFrame, Text = tostring(value), Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = TextColor, BackgroundColor3 = CardColor, Size = UDim2.new(0, 50, 0, 20), Position = UDim2.new(1, -50, 0, 0), TextXAlignment = Enum.TextXAlignment.Center, ClearTextOnFocus = false})
                    Create("UICorner", {Parent = ValueBox, CornerRadius = UDim.new(0, 4)})
                    Create("UIStroke", {Parent = ValueBox, Color = Color3.fromRGB(70, 40, 46), Thickness = 1})

                    local SliderBar = Create("Frame", {Parent = SliderFrame, BackgroundColor3 = Color3.fromRGB(50, 35, 40), Size = UDim2.new(1, 0, 0, 8), Position = UDim2.new(0, 0, 0, 28)})
                    Create("UICorner", {Parent = SliderBar, CornerRadius = UDim.new(1, 0)})
                    local SliderFill = Create("Frame", {Parent = SliderBar, BackgroundColor3 = AccentColor, Size = UDim2.new((value - min) / (max - min), 0, 1, 0)})
                    Create("UICorner", {Parent = SliderFill, CornerRadius = UDim.new(1, 0)})

                    local SliderBtn = Create("TextButton", {Parent = SliderBar, Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), AutoButtonColor = false})

                    local function setSliderValue(newVal, ignoreCallback)
                        value = math.clamp(math.floor(tonumber(newVal) or min), min, max)
                        ValueBox.Text = tostring(value)
                        local percentage = (max == min) and 0 or ((value - min) / (max - min))
                        SliderFill.Size = UDim2.new(percentage, 0, 1, 0)
                        if callback and not ignoreCallback then callback(value) end
                    end

                    local dragging = false
                    local function updateFromInput(input)
                        local sizeX = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
                        setSliderValue(min + ((max - min) * sizeX))
                    end

                    SliderBtn.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            dragging = true
                            updateFromInput(input)
                        end
                    end)

                    UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            dragging = false
                        end
                    end)

                    UserInputService.InputChanged:Connect(function(input)
                        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                            updateFromInput(input)
                        end
                    end)

                    ValueBox.FocusLost:Connect(function()
                        local num = tonumber(ValueBox.Text)
                        if num then setSliderValue(num) else ValueBox.Text = tostring(value) end
                    end)

                    Window.ConfigElements[name] = { Set = function(val) setSliderValue(val) end, Get = function() return value end }
                end

                function Elements:AddDropdown(name, options, default, callback, multi)
                    options = options or {}
                    local selected = {}
                    
                    if multi then
                        if type(default) == "table" then
                            for _, v in ipairs(default) do selected[v] = true end
                        elseif default then
                            selected[default] = true
                        end
                    else
                        local singleVal = default or options[1] or ""
                        selected[singleVal] = true
                    end

                    local opened = false

                    local DropFrame = Create("Frame", {Parent = ItemContainer, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), ClipsDescendants = false, ZIndex = 10})
                    local DropBtn = Create("TextButton", {Parent = DropFrame, Text = "", BackgroundColor3 = CardColor, Size = UDim2.new(1, 0, 0, 32), Position = UDim2.new(0, 0, 0, 0), AutoButtonColor = false, ZIndex = 10})
                    Create("UICorner", {Parent = DropBtn, CornerRadius = UDim.new(0, 6)})
                    AddCornerBorders(DropBtn, AccentColor)
                    Create("UIStroke", {Parent = DropBtn, Color = Color3.fromRGB(70, 40, 46), Thickness = 1.2})

                    Create("TextLabel", {Parent = DropBtn, Text = name, Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = TextColor, BackgroundTransparency = 1, Size = UDim2.new(0.5, 0, 1, 0), Position = UDim2.new(0, 12, 0, 0), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 11})

                    local PreviewBox = Create("Frame", {Parent = DropBtn, BackgroundColor3 = BackgroundColor, Size = UDim2.new(0, 140, 0, 22), Position = UDim2.new(1, -152, 0.5, -11), ZIndex = 11})
                    Create("UICorner", {Parent = PreviewBox, CornerRadius = UDim.new(0, 4)})
                    Create("UIStroke", {Parent = PreviewBox, Color = AccentColor, Thickness = 1})

                    local PreviewText = Create("TextLabel", {Parent = PreviewBox, Text = "", Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = TextColor, BackgroundTransparency = 1, Size = UDim2.new(1, -8, 1, 0), Position = UDim2.new(0, 4, 0, 0), TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 11})

                    local ListFrame = Create("ScrollingFrame", {Parent = DropFrame, BackgroundColor3 = CardColor, Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 0, 36), ScrollBarThickness = 2, BorderSizePixel = 0, CanvasSize = UDim2.new(0, 0, 0, 0), Visible = false, ZIndex = 25})
                    Create("UICorner", {Parent = ListFrame, CornerRadius = UDim.new(0, 6)})
                    AddCornerBorders(ListFrame, AccentColor)
                    Create("UIStroke", {Parent = ListFrame, Color = AccentColor, Thickness = 1.5})
                    local ListLayout = Create("UIListLayout", {Parent = ListFrame, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2)})
                    Create("UIPadding", {Parent = ListFrame, PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4)})

                    local function updatePreview()
                        local list = {}
                        for _, opt in ipairs(options) do
                            if selected[opt] then table.insert(list, tostring(opt)) end
                        end
                        PreviewText.Text = table.concat(list, ", ")
                        if PreviewText.Text == "" then PreviewText.Text = "None" end
                    end

                    updatePreview()

                    ListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                        ListFrame.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y + 8)
                    end)

                    for _, opt in ipairs(options) do
                        local OptBtn = Create("TextButton", {Parent = ListFrame, Text = "  " .. tostring(opt), Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = SubTextColor, BackgroundColor3 = BackgroundColor, BackgroundTransparency = 0.5, Size = UDim2.new(1, 0, 0, 26), AutoButtonColor = false, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 26})
                        Create("UICorner", {Parent = OptBtn, CornerRadius = UDim.new(0, 4)})
                        
                        OptBtn.MouseButton1Click:Connect(function()
                            if multi then
                                selected[opt] = not selected[opt]
                            else
                                table.clear(selected)
                                selected[opt] = true
                                opened = false
                                Tween(DropFrame, {Size = UDim2.new(1, 0, 0, 34)}, 0.2)
                                Tween(ListFrame, {Size = UDim2.new(1, 0, 0, 0)}, 0.2)
                                task.wait(0.2)
                                ListFrame.Visible = false
                            end
                            updatePreview()
                            
                            if callback then
                                if multi then
                                    local result = {}
                                    for _, o in ipairs(options) do if selected[o] then table.insert(result, o) end end
                                    callback(result)
                                else
                                    callback(opt)
                                end
                            end
                        end)
                    end

                    DropBtn.MouseButton1Click:Connect(function()
                        opened = not opened
                        if opened then
                            ListFrame.Visible = true
                            local targetHeight = math.clamp(#options * 28 + 10, 0, 140)
                            Tween(DropFrame, {Size = UDim2.new(1, 0, 0, 40 + targetHeight)}, 0.2)
                            Tween(ListFrame, {Size = UDim2.new(1, 0, 0, targetHeight)}, 0.2)
                        else
                            Tween(DropFrame, {Size = UDim2.new(1, 0, 0, 34)}, 0.2)
                            Tween(ListFrame, {Size = UDim2.new(1, 0, 0, 0)}, 0.2)
                            task.wait(0.2)
                            ListFrame.Visible = false
                        end
                    end)

                    Window.ConfigElements[name] = { 
                        Set = function(val) 
                            table.clear(selected)
                            if type(val) == "table" then
                                for _, v in ipairs(val) do selected[v] = true end
                            else
                                selected[val] = true
                            end
                            updatePreview()
                        end, 
                        Get = function() 
                            if multi then
                                local result = {}
                                for _, o in ipairs(options) do if selected[o] then table.insert(result, o) end end
                                return result
                            else
                                for o, v in pairs(selected) do if v then return o end end
                            end
                        end 
                    }
                end

                function Elements:AddConfigManager(folderName)
                    folderName = folderName or "kenzhubSavers"
                    if not _isfolder(folderName) then _makefolder(folderName) end
                    Create("TextLabel", {Parent = ItemContainer, Text = "Config Manager (Folder: " .. folderName .. ")", Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = TextColor, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Left})
                end

                return Elements
            end
            return PageObj
        end
        return TabConfig
    end

    function Window:MakeTab(tabName, icon)
        return self:CreateTab(tabName, icon)
    end

    return Window
end

return Library
