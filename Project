                    ZIndex = 10
                })

                local Lever = Create("TextButton", {
                    Parent = TogFrame,
                    Text = "",
                    BackgroundColor3 = state and AccentColor or Color3.fromRGB(50, 50, 50),
                    Size = UDim2.new(0, 34, 0, 16),
                    Position = UDim2.new(1, -34, 0.5, -8),
                    AutoButtonColor = false,
                    ZIndex = 10
                })
                Create("UICorner", {Parent = Lever, CornerRadius = UDim.new(1, 0)})
                Create("UIStroke", {Parent = Lever, Color = AccentColor, Thickness = 1.2})
                AddBounce(Lever)

                local Knob = Create("Frame", {
                    Parent = Lever,
                    BackgroundColor3 = state and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255),
                    Size = UDim2.new(0, 12, 0, 12),
                    Position = state and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6),
                    ZIndex = 11
                })
                Create("UICorner", {Parent = Knob, CornerRadius = UDim.new(1, 0)})

                local function internalSet(val, skipCallback)
                    state = val
                    Tween(Lever, {BackgroundColor3 = state and AccentColor or Color3.fromRGB(50, 50, 50)}, 0.3)
                    Tween(Knob, {
                        Position = state and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6),
                        BackgroundColor3 = state and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)
                    }, 0.3)
                    if configPath and not noSave then
                        Library.ConfigSystem.Set(configPath, state)
                        MarkDirty()
                    end
                    Library.flags[configPath or title] = state
                    if callback and not skipCallback then callback(state) end
                end

                Lever.MouseButton1Click:Connect(function() internalSet(not state) end)

                if configPath and not noSave then
                    RegisterCallback(configPath, callback, "toggle", default, function(val)
                        internalSet(val, true)
                    end)
                end
                Library.flags[configPath or title] = state
                registerFeature(title, TogFrame)

                return {
                    SetValue = function(self, val) internalSet(val) end,
                    GetValue = function(self) return state end
                }
            end

