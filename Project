function Library.FeatureHUDManager:GetRow()
    local rowCount = #self.Rows
    local lastRow = self.Rows[rowCount]
    if not lastRow or (#lastRow:GetChildren() - 1) >= 3 then
        lastRow = Create("Frame", {
            Parent = MainContainer,
            Name = "Row" .. (rowCount + 1),
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.XY,
            LayoutOrder = rowCount + 1
        })
        Create("UIListLayout", {
            Parent = lastRow,
            FillDirection = Enum.FillDirection.Horizontal,
            HorizontalAlignment = Enum.HorizontalAlignment.Right,
            VerticalAlignment = Enum.VerticalAlignment.Center,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 10)
        })
        table.insert(self.Rows, lastRow)
    end
    return lastRow
end

function Library.FeatureHUDManager:AddButton(text, clickCallback, hotkeyString)
    if not isMobile then
        return self:AddPCIndicator(text, hotkeyString)
    end
    local row = self:GetRow()
    local container = Create("Frame", {
        Parent = row,
        Name = "HUDButton_" .. text,
        Size = UDim2.new(0, 0, 0, 56),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundColor3 = Color3.fromRGB(20, 10, 0),
        BackgroundTransparency = 0.6,
        BorderSizePixel = 0,
        LayoutOrder = #self.Buttons
    })
    local overlay = Create("Frame", {
        Parent = container,
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 5
    })
    Create("UICorner", {Parent = overlay, CornerRadius = UDim.new(0, 6)})
    Create("UICorner", {Parent = container, CornerRadius = UDim.new(0, 6)})
    local stroke = Create("UIStroke", {Parent = container, Color = Color3.fromRGB(255, 120, 0), Thickness = 1})
    Create("UIGradient", {
        Parent = stroke, Rotation = 90,
        Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 170, 0)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 80, 0)),
        }
    })
    Create("UIGradient", {
        Parent = container, Rotation = 90,
        Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(40, 20, 0)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(15, 5, 0)),
        }
    })
    Create("UIPadding", {Parent = container, PaddingLeft = UDim.new(0, 32), PaddingRight = UDim.new(0, 32)})
    local label = Create("TextLabel", {
        Parent = container,
        Name = "Label",
        Size = UDim2.new(0, 0, 1, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 20,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        RichText = true,
        Text = "<b>" .. text .. "</b>"
    })
    local btn = Create("TextButton", {
        Parent = container,
        Name = "ClickArea",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 10
    })
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Tween(overlay, TweenInfo.new(0.1), {BackgroundTransparency = 0.5})
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    Tween(overlay, TweenInfo.new(0.1), {BackgroundTransparency = 1})
                end
            end)
        end
    end)
    if clickCallback then btn.MouseButton1Click:Connect(clickCallback) end
    local ref = {
        container = container,
        UpdateHotkey = function(self, newH) end,
        UpdateText = function(self, newT) if label then label.Text = "<b>" .. tostring(newT) .. "</b>" end end
    }
    table.insert(self.Buttons, ref)
    return ref
end

function Library.FeatureHUDManager:AddPCIndicator(text, hotkeyString)
    local container = Create("Frame", {
        Parent = PCContainer,
        Name = "PCIndicator_" .. text,
        Size = UDim2.new(0, 0, 0, 24),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundColor3 = BackgroundColor,
        BorderSizePixel = 0,
        LayoutOrder = #self.Buttons
    })
    Create("UIGradient", {
        Parent = container,
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.3, 0.5),
            NumberSequenceKeypoint.new(1, 0.2)
        })
    })
    Create("UIListLayout", {
        Parent = container,
        FillDirection = Enum.FillDirection.Horizontal,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder
    })
    Create("Frame", {Parent = container, Size = UDim2.new(0, 40, 1, 0), BackgroundTransparency = 1, LayoutOrder = 1})
    local label = Create("TextLabel", {
        Parent = container,
        Size = UDim2.new(0, 0, 1, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextColor3 = TextColor,
        RichText = true,
        LayoutOrder = 2
    })
    Create("Frame", {Parent = container, Size = UDim2.new(0, 12, 1, 0), BackgroundTransparency = 1, LayoutOrder = 3})
    Create("Frame", {Parent = container, Size = UDim2.new(0, 3, 1, 0), BackgroundColor3 = AccentColor, BorderSizePixel = 0, LayoutOrder = 4})

    local ref = {
        container = container,
        text = text,
        label = label,
        hotkey = hotkeyString or "None"
    }
    function ref:UpdateHotkey(newHotkey)
        self.hotkey = (newHotkey and tostring(newHotkey) ~= "") and tostring(newHotkey) or "None"
        self.label.Text = string.format("<font color='#FFFFFF'>[%s]</font>  %s", self.hotkey, self.text)
    end
    function ref:UpdateText(newText)
        self.text = tostring(newText)
        self:UpdateHotkey(self.hotkey)
    end
    ref:UpdateHotkey(hotkeyString)
    table.insert(self.Buttons, ref)
    return ref
end

function Library.FeatureHUDManager:RemoveButton(ref)
    if not ref then return end
    local container = type(ref) == "table" and ref.container or ref
    for i, b in ipairs(self.Buttons) do
        local bContainer = type(b) == "table" and b.container or b
        if bContainer == container or b == ref then
            table.remove(self.Buttons, i)
            break
        end
    end
    if container and container.Parent then container:Destroy() end
end

return Library
