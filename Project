                        BackgroundColor3 = ButtonColor,
                        Size = UDim2.new(1, 0, 0, 28),
                        Position = UDim2.new(0, 0, 0, 0),
                        AutoButtonColor = false,
                        ZIndex = 26
                    })

                    Create("UICorner", {
                        Parent = DropBtn,
                        CornerRadius = UDim.new(0, 4)
                    })

                    Create("UIStroke", {
                        Parent = DropBtn,
                        Color = AccentColor,
                        Thickness = 1.2
                    })

                    Create("TextLabel", {
                        Parent = DropBtn,
                        Text = name,
                        Font = Enum.Font.GothamBold,
                        TextSize = 10,
                        TextColor3 = TextColor,
                        BackgroundTransparency = 1,
                        Size = UDim2.new(0.4, 0, 1, 0),
                        Position = UDim2.new(0, 10, 0, 0),
                        TextXAlignment = Enum.TextXAlignment.Left,
                        ZIndex = 27
                    })

                    local PreviewBox = Create("Frame", {
                        Parent = DropBtn,
                        BackgroundColor3 = BackgroundColor,
                        Size = UDim2.new(0, 100, 0, 18),
                        Position = UDim2.new(1, -108, 0.5, -9),
                        ZIndex = 27
                    })

                    Create("UICorner", {
                        Parent = PreviewBox,
                        CornerRadius = UDim.new(0, 3)
                    })

                    Create("UIStroke", {
                        Parent = PreviewBox,
                        Color = AccentColor,
                        Thickness = 1.2
                    })

                    local PreviewText = Create("TextLabel", {
                        Parent = PreviewBox,
                        Text = "",
                        Font = Enum.Font.Gotham,
                        TextSize = 9,
                        TextColor3 = TextColor,
                        BackgroundTransparency = 1,
                        Size = UDim2.new(1, -6, 1, 0),
                        Position = UDim2.new(0, 3, 0, 0),
                        TextXAlignment = Enum.TextXAlignment.Right,
                        TextTruncate = Enum.TextTruncate.AtEnd,
                        ZIndex = 27
                    })

                    local ListFrame = Create("ScrollingFrame", {
                        Parent = DropFrame,
                        BackgroundColor3 = CardColor,
                        Size = UDim2.new(1, 0, 0, 0),
                        Position = UDim2.new(0, 0, 0, 28),
                        ScrollBarThickness = 2,
                        BorderSizePixel = 0,
                        CanvasSize = UDim2.new(0, 0, 0, 0),
                        Visible = false,
                        ZIndex = 50
                    })

                    Create("UICorner", {
                        Parent = ListFrame,
                        CornerRadius = UDim.new(0, 4)
                    })

                    Create("UIStroke", {
                        Parent = ListFrame,
                        Color = AccentColor,
                        Thickness = 1.4
                    })

                    local ListLayout = Create("UIListLayout", {
                        Parent = ListFrame,
                        SortOrder = Enum.SortOrder.LayoutOrder,
                        Padding = UDim.new(0, 2)
                    })

                    Create("UIPadding", {
                        Parent = ListFrame,
                        PaddingTop = UDim.new(0, 3),
                        PaddingBottom = UDim.new(0, 3),
                        PaddingLeft = UDim.new(0, 3),
                        PaddingRight = UDim.new(0, 3)
                    })

                    local optionButtons = {}

                    local function updatePreview()
                        local list = {}

                        for _, opt in ipairs(options) do
                            if selected[opt] then
                                table.insert(list, tostring(opt))
                            end
                        end

                        PreviewText.Text = table.concat(list, ", ")

                        if PreviewText.Text == "" then
                            PreviewText.Text = "None"
                        end

                        for opt, btn in pairs(optionButtons) do
                            local checkMark = btn:FindFirstChild("CheckMark")

                            if selected[opt] then
                                Tween(btn, {
                                    BackgroundColor3 = Color3.fromRGB(60, 60, 60),
                                    BackgroundTransparency = 0.2
                                }, 0.2)

                                btn.TextColor3 = Color3.fromRGB(255, 255, 255)

                                if checkMark then
                                    checkMark.Text = "✓"
                                end
                            else
                                Tween(btn, {
                                    BackgroundColor3 = BackgroundColor,
                                    BackgroundTransparency = 0.5
                                }, 0.2)

                                btn.TextColor3 = SubTextColor

                                if checkMark then
                                    checkMark.Text = ""
                                end
                            end
                        end
                    end

                    ListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                        ListFrame.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y + 6)
                    end)

                    for _, opt in ipairs(options) do
                        local OptBtn = Create("TextButton", {
                            Parent = ListFrame,
                            Text = "  " .. tostring(opt),
                            Font = Enum.Font.Gotham,
                            TextSize = 10,
                            TextColor3 = SubTextColor,
                            BackgroundColor3 = BackgroundColor,
                            BackgroundTransparency = 0.5,
                            Size = UDim2.new(1, 0, 0, 22),
                            AutoButtonColor = false,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            ZIndex = 51
                        })

                        Create("UICorner", {
                            Parent = OptBtn,
                            CornerRadius = UDim.new(0, 3)
                        })

                        local CheckMark = Create("TextLabel", {
                            Parent = OptBtn,
                            Name = "CheckMark",
                            Text = "",
                            Font = Enum.Font.GothamBold,
                            TextSize = 10,
                            TextColor3 = Color3.fromRGB(255, 255, 255),
                            BackgroundTransparency = 1,
                            Size = UDim2.new(0, 20, 1, 0),
                            Position = UDim2.new(1, -22, 0, 0),
                            TextXAlignment = Enum.TextXAlignment.Center,
                            ZIndex = 52
                        })

                        optionButtons[opt] = OptBtn

                        OptBtn.MouseButton1Click:Connect(function()
                            if multi then
                                selected[opt] = not selected[opt]
                            else
                                table.clear(selected)
                                selected[opt] = true
                                opened = false

                                Tween(DropFrame, {
                                    Size = UDim2.new(1, 0, 0, 28)
                                }, 0.2)

                                Tween(ListFrame, {
                                    Size = UDim2.new(1, 0, 0, 0)
                                }, 0.2)

                                task.wait(0.2)
                                ListFrame.Visible = false
                            end

                            updatePreview()

                            if callback then
                                if multi then
                                    local result = {}

                                    for _, o in ipairs(options) do
                                        if selected[o] then
                                            table.insert(result, o)
                                        end
                                    end

                                    callback(result)
                                else
                                    callback(opt)
                                end
                            end
                        end)
                    end

                    updatePreview()

                    DropBtn.MouseButton1Click:Connect(function()
                        opened = not opened

                        if opened then
                            ListFrame.Visible = true

                            local targetHeight = math.clamp(#options * 24 + 6, 0, 110)

                            Tween(DropFrame, {
                                Size = UDim2.new(1, 0, 0, 28 + targetHeight)
                            }, 0.2)

                            Tween(ListFrame, {
                                Size = UDim2.new(1, 0, 0, targetHeight)
                            }, 0.2)
                        else
                            Tween(DropFrame, {
                                Size = UDim2.new(1, 0, 0, 28)
                            }, 0.2)

                            Tween(ListFrame, {
                                Size = UDim2.new(1, 0, 0, 0)
                            }, 0.2)

                            task.wait(0.2)
                            ListFrame.Visible = false
                        end
                    end)

                    Window.ConfigElements[name] = {
                        Set = function(val)
                            table.clear(selected)

                            if type(val) == "table" then
                                for _, v in ipairs(val) do
                                    selected[v] = true
                                end
                            else
                                selected[val] = true
                            end

                            updatePreview()
                        end,

                        Get = function()
                            if multi then
                                local result = {}

                                for _, o in ipairs(options) do
                                    if selected[o] then
                                        table.insert(result, o)
                                    end
                                end

                                return result
                            else
                                for o, v in pairs(selected) do
                                    if v then
                                        return o
                                    end
                                end
                            end
                        end
                    }
                end

                return Elements
            end

            return PageObj
        end

        return TabConfig
    end

    function Window:MakeTab(tabName, icon)
        return self:CreateTab(tabName, icon)
    end

    return Window
end

return Library
