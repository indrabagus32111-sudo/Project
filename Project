    end
    addClearLine(45)
    addClearLine(-45)
    local function setClearColor(c)
        for _, line in ipairs(clearLines) do
            line.BackgroundColor3 = c
        end
    end
    local ROW_H, ROW_GAP, LIST_PAD, MAX_PANEL_H = 32, 3, 4, 168
    local resultsPanel = new("Frame", {
