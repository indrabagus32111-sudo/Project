    Tween(TitleText, {TextTransparency = 0}, 0.3)
    Tween(DescText, {TextTransparency = 0}, 0.3)
    Tween(CloseNotifBtn, {TextTransparency = 0}, 0.3)

    task.delay(duration, function()
        if not destroyed then
            removeNotif()
        end
    end)
