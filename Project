            local PageBtn = Create("TextButton", {Parent = PageNav, Text = pageName, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = SubTextColor, BackgroundTransparency = 1, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X})
            local PageHighlight = Create("Frame", {Parent = PageBtn, BackgroundColor3 = AccentColor, Size = UDim2.new(0, 0, 0, 2), Position = UDim2.new(0.5, 0, 1, -4), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1})
            local PageScroll = Create("ScrollingFrame", {Parent = PageContainer, BackgroundTransparency = 1, Size = UDim2.new(1, -8, 1, -8), Position = UDim2.new(0, 4, 0, 4), ScrollBarThickness = 2, ScrollBarImageColor3 = Color3.fromRGB(60, 40, 45), Visible = false, BorderSizePixel = 0})

            local MainColumn = Create("Frame", {Parent = PageScroll, BackgroundTransparency = 1, Size = UDim2.new(1, -12, 1, 0)})
            local M_Layout = Create("UIListLayout", {Parent = MainColumn, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8)})
            M_Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() 
                PageScroll.CanvasSize = UDim2.new(0, 0, 0, M_Layout.AbsoluteContentSize.Y + 20) 
            end)

            local PageObj = {Scroll = PageScroll, Btn = PageBtn, Highlight = PageHighlight, MainColumn = MainColumn}
            table.insert(TabConfig.Pages, PageObj)

            PageBtn.MouseButton1Click:Connect(function()
                if TabConfig.CurrentPage == PageObj then return end
                if TabConfig.CurrentPage then
                    Tween(TabConfig.CurrentPage.Btn, {TextColor3 = SubTextColor}, 0.2)
                    Tween(TabConfig.CurrentPage.Highlight, {Size = UDim2.new(0, 0, 0, 2), BackgroundTransparency = 1}, 0.2)
                    TabConfig.CurrentPage.Scroll.Visible = false
                end
                TabConfig.CurrentPage = PageObj
                PageObj.Scroll.Visible = true
                Tween(PageBtn, {TextColor3 = TextColor}, 0.2)
                Tween(PageHighlight, {Size = UDim2.new(1, 0, 0, 2), BackgroundTransparency = 0}, 0.3)
            end)

            if #TabConfig.Pages == 1 then
                TabConfig.CurrentPage = PageObj
                PageObj.Scroll.Visible = true
                PageBtn.TextColor3 = TextColor
                PageHighlight.Size = UDim2.new(1, 0, 0, 2)
                PageHighlight.BackgroundTransparency = 0
            end

            function PageObj:CreateSection(secName)
                local SectionContainer = Create("Frame", {Parent = MainColumn, BackgroundColor3 = CardColor, Size = UDim2.new(1, 0, 0, 26), AutomaticSize = Enum.AutomaticSize.Y, ClipsDescendants = true})
                Create("UICorner", {Parent = SectionContainer, CornerRadius = UDim.new(0, 6)})
                table.insert(Window.AllCards, {Card = SectionContainer, OrigParent = MainColumn, Tab = TabConfig, Page = PageObj, SearchIndex = nil})
                Create("TextLabel", {Parent = SectionContainer, Text = secName, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = TextColor, BackgroundTransparency = 1, Size = UDim2.new(1, -16, 0, 26), Position = UDim2.new(0, 12, 0, 0), TextXAlignment = Enum.TextXAlignment.Left})
                local ItemContainer = Create("Frame", {Parent = SectionContainer, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 0, 26), AutomaticSize = Enum.AutomaticSize.Y})
                Create("UIPadding", {Parent = ItemContainer, PaddingBottom = UDim.new(0, 10), PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10)})
                Create("UIListLayout", {Parent = ItemContainer, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6)})

                local Elements = {}

                function Elements:AddParagraph(title, desc)
                    local ParaFrame = Create("Frame", {Parent = ItemContainer, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y})
                    Create("TextLabel", {Parent = ParaFrame, Text = title, Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = TextColor, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 0, 0), TextXAlignment = Enum.TextXAlignment.Left})
                    Create("TextLabel", {Parent = ParaFrame, Text = tostring(desc), Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = SubTextColor, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, AutomaticSize = Enum.AutomaticSize.Y})
                    Create("UIPadding", {Parent = ParaFrame, PaddingBottom = UDim.new(0, 6)})
                end

                function Elements:AddProfile(imageUrl, playerName)
                    local ProfFrame = Create("Frame", {Parent = ItemContainer, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48)})
                    local AvatarImg = Create("ImageLabel", {Parent = ProfFrame, Image = imageUrl, BackgroundColor3 = CardColor, Size = UDim2.new(0, 38, 0, 38), Position = UDim2.new(0, 0, 0.5, -19)})
                    Create("UICorner", {Parent = AvatarImg, CornerRadius = UDim.new(1, 0)})
                    Create("UIStroke", {Parent = AvatarImg, Color = AccentColor, Thickness = 1})
                    Create("TextLabel", {Parent = ProfFrame, Text = "Welcome,", Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = SubTextColor, BackgroundTransparency = 1, Size = UDim2.new(1, -45, 0, 12), Position = UDim2.new(0, 45, 0.5, -12), TextXAlignment = Enum.TextXAlignment.Left})
                    Create("TextLabel", {Parent = ProfFrame, Text = playerName, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = TextColor, BackgroundTransparency = 1, Size = UDim2.new(1, -45, 0, 16), Position = UDim2.new(0, 45, 0.5, 0), TextXAlignment = Enum.TextXAlignment.Left})
                end

                function Elements:AddButton(name, callback, infoData)
                    local BtnFrame = Create("Frame", {Parent = ItemContainer, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30)})
                    local Btn = Create("TextButton", {Parent = BtnFrame, Text = name, Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = TextColor, BackgroundColor3 = BackgroundColor, Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(0, 0, 0, 0), AutoButtonColor = false})
                    Create("UICorner", {Parent = Btn, CornerRadius = UDim.new(0, 5)})
                    Create("UIStroke", {Parent = Btn, Color = Color3.fromRGB(50, 35, 40), Thickness = 1})
                    AddBounce(Btn)
                    Btn.MouseEnter:Connect(function() Tween(Btn, {BackgroundColor3 = HoverColor}, 0.2) end)
                    Btn.MouseLeave:Connect(function() Tween(Btn, {BackgroundColor3 = BackgroundColor}, 0.2) end)
                    Btn.MouseButton1Click:Connect(function() if callback then callback() end end)
                    AddInfoIcon(BtnFrame, UDim2.new(1, -20, 0.5, -8), infoData)
                end

                function Elements:AddToggle(name, default, callback, infoData)
                    local state = default or false
                    local TogFrame = Create("Frame", {Parent = ItemContainer, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 26)})
                    Create("TextLabel", {Parent = TogFrame, Text = name, Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = SubTextColor, BackgroundTransparency = 1, Size = UDim2.new(1, -50, 1, 0), Position = UDim2.new(0, 0, 0, 0), TextXAlignment = Enum.TextXAlignment.Left})
                    local Lever = Create("TextButton", {Parent = TogFrame, Text = "", BackgroundColor3 = state and AccentColor or Color3.fromRGB(50, 35, 40), Size = UDim2.new(0, 36, 0, 18), Position = UDim2.new(1, -40, 0.5, -9), AutoButtonColor = false})
                    Create("UICorner", {Parent = Lever, CornerRadius = UDim.new(1, 0)})
                    AddBounce(Lever)
                    local Knob = Create("Frame", {Parent = Lever, BackgroundColor3 = Color3.fromRGB(255, 255, 255), Size = UDim2.new(0, 14, 0, 14), Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)})
                    Create("UICorner", {Parent = Knob, CornerRadius = UDim.new(1, 0)})

                    local function internalSet(val)
                        state = val
                        Tween(Lever, {BackgroundColor3 = state and AccentColor or Color3.fromRGB(50, 35, 40)}, 0.3)
                        Tween(Knob, {Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)}, 0.3)
                        if callback then callback(state) end
                    end

                    Lever.MouseButton1Click:Connect(function() internalSet(not state) end)
                    AddInfoIcon(TogFrame, UDim2.new(1, -62, 0.5, -8), infoData)
                    Window.ConfigElements[name] = { Set = internalSet, Get = function() return state end }
                end

                function Elements:AddSlider(name, min, max, default, callback, infoData)
                    min = min or 0
                    max = max or 100
                    default = default or min
                    local value = math.clamp(default, min, max)

                    local SliderFrame = Create("Frame", {Parent = ItemContainer, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 42)})
                    Create("TextLabel", {Parent = SliderFrame, Text = name, Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = SubTextColor, BackgroundTransparency = 1, Size = UDim2.new(1, -65, 0, 18), Position = UDim2.new(0, 0, 0, 0), TextXAlignment = Enum.TextXAlignment.Left})
                    
                    local ValueBox = Create("TextBox", {Parent = SliderFrame, Text = tostring(value), Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = TextColor, BackgroundColor3 = BackgroundColor, Size = UDim2.new(0, 44, 0, 18), Position = UDim2.new(1, -44, 0, 0), TextXAlignment = Enum.TextXAlignment.Center, ClearTextOnFocus = false})
                    Create("UICorner", {Parent = ValueBox, CornerRadius = UDim.new(0, 4)})
                    Create("UIStroke", {Parent = ValueBox, Color = Color3.fromRGB(50, 35, 40), Thickness = 1})

                    local SliderBar = Create("Frame", {Parent = SliderFrame, BackgroundColor3 = Color3.fromRGB(50, 35, 40), Size = UDim2.new(1, 0, 0, 6), Position = UDim2.new(0, 0, 0, 26)})
                    Create("UICorner", {Parent = SliderBar, CornerRadius = UDim.new(1, 0)})
                    local SliderFill = Create("Frame", {Parent = SliderBar, BackgroundColor3 = AccentColor, Size = UDim2.new((value - min) / (max - min), 0, 1, 0)})
                    Create("UICorner", {Parent = SliderFill, CornerRadius = UDim.new(1, 0)})

                    local SliderBtn = Create("TextButton", {Parent = SliderBar, Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), AutoButtonColor = false})

                    local function setSliderValue(newVal, ignoreCallback)
                        value = math.clamp(math.floor(tonumber(newVal) or min), min, max)
                        ValueBox.Text = tostring(value)
                        local percentage = (max == min) and 0 or ((value - min) / (max - min))
                        SliderFill.Size = UDim2.new(percentage, 0, 1, 0)
                        if callback and not ignoreCallback then callback(value) end
                    end

                    local dragging = false
                    local function updateFromInput(input)
                        local sizeX = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
                        setSliderValue(min + ((max - min) * sizeX))
                    end

                    SliderBtn.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            dragging = true
                            updateFromInput(input)
                        end
                    end)

                    UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            dragging = false
                        end
                    end)

                    UserInputService.InputChanged:Connect(function(input)
                        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                            updateFromInput(input)
                        end
                    end)

                    ValueBox.FocusLost:Connect(function()
                        local num = tonumber(ValueBox.Text)
                        if num then setSliderValue(num) else ValueBox.Text = tostring(value) end
                    end)

                    AddInfoIcon(SliderFrame, UDim2.new(1, -52, 0, 1), infoData)
                    Window.ConfigElements[name] = { Set = function(val) setSliderValue(val) end, Get = function() return value end }
                end

                function Elements:AddDropdown(name, options, default, callback, infoData)
                    options = options or {}
                    local selected = default or options[1] or ""
                    local opened = false

                    local DropFrame = Create("Frame", {Parent = ItemContainer, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), ClipsDescendants = true})
                    local DropBtn = Create("TextButton", {Parent = DropFrame, Text = "", BackgroundColor3 = BackgroundColor, Size = UDim2.new(1, 0, 0, 28), Position = UDim2.new(0, 0, 0, 0), AutoButtonColor = false})
                    Create("UICorner", {Parent = DropBtn, CornerRadius = UDim.new(0, 4)})
                    Create("UIStroke", {Parent = DropBtn, Color = Color3.fromRGB(50, 35, 40), Thickness = 1})

                    local TitleLbl = Create("TextLabel", {Parent = DropBtn, Text = name .. ": " .. tostring(selected), Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = TextColor, BackgroundTransparency = 1, Size = UDim2.new(1, -24, 1, 0), Position = UDim2.new(0, 8, 0, 0), TextXAlignment = Enum.TextXAlignment.Left})
                    local ListFrame = Create("ScrollingFrame", {Parent = DropFrame, BackgroundColor3 = Color3.fromRGB(18, 12, 14), Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 0, 30), ScrollBarThickness = 2, BorderSizePixel = 0, CanvasSize = UDim2.new(0, 0, 0, 0), Visible = false})
                    Create("UICorner", {Parent = ListFrame, CornerRadius = UDim.new(0, 4)})
                    Create("UIStroke", {Parent = ListFrame, Color = Color3.fromRGB(50, 35, 40), Thickness = 1})
                    local ListLayout = Create("UIListLayout", {Parent = ListFrame, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2)})

                    ListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                        ListFrame.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y + 4)
                    end)

                    for _, opt in ipairs(options) do
                        local OptBtn = Create("TextButton", {Parent = ListFrame, Text = tostring(opt), Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = SubTextColor, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24), AutoButtonColor = false})
                        OptBtn.MouseButton1Click:Connect(function()
                            selected = opt
                            TitleLbl.Text = name .. ": " .. tostring(selected)
                            opened = false
                            Tween(DropFrame, {Size = UDim2.new(1, 0, 0, 30)}, 0.2)
                            Tween(ListFrame, {Size = UDim2.new(1, 0, 0, 0)}, 0.2)
                            task.wait(0.2)
                            ListFrame.Visible = false
                            if callback then callback(selected) end
                        end)
                    end

                    DropBtn.MouseButton1Click:Connect(function()
                        opened = not opened
                        if opened then
                            ListFrame.Visible = true
                            local targetHeight = math.clamp(#options * 26, 0, 130)
                            Tween(DropFrame, {Size = UDim2.new(1, 0, 0, 34 + targetHeight)}, 0.2)
                            Tween(ListFrame, {Size = UDim2.new(1, 0, 0, targetHeight)}, 0.2)
                        else
                            Tween(DropFrame, {Size = UDim2.new(1, 0, 0, 30)}, 0.2)
                            Tween(ListFrame, {Size = UDim2.new(1, 0, 0, 0)}, 0.2)
                            task.wait(0.2)
                            ListFrame.Visible = false
                        end
                    end)

                    AddInfoIcon(DropFrame, UDim2.new(1, -20, 0, 6), infoData)
                    Window.ConfigElements[name] = { Set = function(val) selected = val TitleLbl.Text = name .. ": " .. tostring(selected) if callback then callback(selected) end end, Get = function() return selected end }
                end

                function Elements:AddConfigManager(folderName)
                    folderName = folderName or "kenzhubSavers"
                    if not _isfolder(folderName) then _makefolder(folderName) end
                    Create("TextLabel", {Parent = ItemContainer, Text = "Config Manager (Folder: " .. folderName .. ")", Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = TextColor, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Left})
                end

                return Elements
            end
            return PageObj
        end
        return TabConfig
    end

    function Window:MakeTab(tabName, icon)
        return self:CreateTab(tabName, icon)
    end

    return Window
end

return Library
